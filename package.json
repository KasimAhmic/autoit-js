{
  "name": "@ahmic/autoit-js",
  "version": "1.0.0",
  "description": "Node.js bindings for AutoItX3.dll",
  "main": "index.js",
  "scripts": {
    "start": "tsx ./src/main.ts",
    "test": "vitest",
    "lint": "eslint src",
    "build": "tsc",
